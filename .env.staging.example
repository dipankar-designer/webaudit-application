# WebAudit AI — staging configuration template.
# Copy to .env on the staging server and replace every CHANGE_ME. Full reference: .env.example and docs/DEPLOYMENT.md.
#
# Production mode sends the session cookie over HTTPS only, so serve staging through a TLS-terminating
# reverse proxy (nginx, Caddy, load balancer). Over plain http:// sign-in will not stick.

NODE_ENV=production
# The API listens here; point the reverse proxy at it. (docker-compose.yml overrides this with 0.0.0.0.)
HOST=127.0.0.1
PORT=4100
APP_ORIGIN=https://CHANGE_ME.staging.example
TRUST_PROXY=true

# PostgreSQL 14+ with UTF8 encoding (create with: createdb -E UTF8 --locale=C -T template0 wpcg).
# Migrations run automatically when the API starts. Docker Compose sets this itself from POSTGRES_PASSWORD.
DATABASE_URL=postgres://wpcg:CHANGE_ME@127.0.0.1:5432/wpcg

# Screenshots and diff images. Must be writable and shared by the API and the worker.
STORAGE_DIR=/var/lib/webaudit/storage
SESSION_TTL_HOURS=168
DEFAULT_RETENTION_DAYS=90
# false = invitation-only.
SIGNUPS_ENABLED=true

# Leave empty to auto-detect Chrome/Chromium (/usr/bin/chromium, Google Chrome, Playwright's Chromium).
# CHROME_PATH=/usr/bin/chromium

# Run the worker as its own process (node server/dist/worker.js). Chrome needs ~1–1.5 GB RAM per scan.
RUN_WORKER_IN_PROCESS=false
WORKER_CONCURRENCY=1
SCAN_PAGE_CONCURRENCY=2
LIGHTHOUSE_RUNS=3
SCAN_USER_AGENT=WebAuditAIBot/0.1 (+https://CHANGE_ME.staging.example/bot)

# Optional AI explanations: none | anthropic | ollama
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

MONITORING_ENABLED=true
MONITOR_CONCURRENCY=4
# APP_PUBLIC_URL=https://CHANGE_ME.staging.example

# E-mail alerts. Without SMTP_HOST incidents are still recorded and deliveries are logged as "skipped".
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# ALERT_FROM="WebAudit AI <alerts@CHANGE_ME.example>"

# Optional: real-user Core Web Vitals (Chrome UX Report API key).
# CRUX_API_KEY=

# Optional: Stripe billing (test-mode keys on staging).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_AGENCY=price_...
