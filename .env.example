# WebAudit AI — example configuration. Copy to .env and adjust.
# Never commit a real .env. All secrets stay on the server.

NODE_ENV=development
HOST=127.0.0.1
PORT=4100
# Origin the browser uses to reach the app (Vite dev server in development).
APP_ORIGIN=http://localhost:5174
# Set to true when running behind a reverse proxy / load balancer that sets X-Forwarded-*.
TRUST_PROXY=false

# PostgreSQL. In development `npm run db:start` runs a local PostgreSQL 17 with these values.
DATABASE_URL=postgres://wpcg:wpcg_dev_password@127.0.0.1:5433/wpcg
DEV_PG_PORT=5433
DEV_PG_PASSWORD=wpcg_dev_password
# DEV_PG_DIR=.data/postgres

# Screenshots and diff images (relative to the repository root, or absolute).
STORAGE_DIR=./storage
SESSION_TTL_HOURS=168
DEFAULT_RETENTION_DAYS=90
SIGNUPS_ENABLED=true

# Browser: leave empty to auto-detect Chrome/Chromium, or give the executable path.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Worker. In development the API can run the worker in-process; in production run `npm run worker` separately.
RUN_WORKER_IN_PROCESS=false
WORKER_CONCURRENCY=1
SCAN_PAGE_CONCURRENCY=3
SCAN_HARD_MAX_PAGES=1000
SCAN_PAGE_TIMEOUT_MS=30000
SCAN_MAX_DURATION_MS=5400000
SCAN_MAX_RESPONSE_BYTES=5242880
SCAN_MAX_REDIRECTS=5
SCAN_MAX_CRAWL_DEPTH=3
LINK_CHECK_MAX=2000
LINK_CHECK_CONCURRENCY=4
LIGHTHOUSE_MAX_PAGES=3
# Lighthouse runs per device on the home page; the median run is reported (1–5). One run can swing 20+
# points with network conditions; 3 is Lighthouse's recommendation. Each run takes about 30–60 s.
LIGHTHOUSE_RUNS=3
SCAN_USER_AGENT=WebAuditAIBot/0.1 (+https://your-domain.example/bot)

# DEVELOPMENT/TEST ONLY — ignored when NODE_ENV=production.
# Comma-separated host[:port] values that may be scanned although they are private (e.g. a local fixture site).
SCAN_ALLOW_PRIVATE_TARGETS=

# Optional AI explanations: none | anthropic | ollama
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
# Largest context window requested from Ollama (tokens). Prompts are sized to fit up to this; Ollama's own
# default (2–4k) silently drops the start of long prompts. Larger values use more memory and are slower on CPU.
# OLLAMA_MAX_CTX=16384
AI_MAX_OUTPUT_TOKENS=16000
AI_TIMEOUT_MS=90000

# ---------------------------------------------------------------- monitoring
# The worker runs the monitoring scheduler (uptime, TLS, DNS, ... watchers). Set false to run scans only.
MONITORING_ENABLED=true
# How many watcher runs one worker executes at the same time.
MONITOR_CONCURRENCY=4
# Public address of the app, used in alert e-mails, heartbeat URLs and Stripe return URLs. Defaults to APP_ORIGIN.
# APP_PUBLIC_URL=https://monitor.example.com

# E-mail alerts (any SMTP provider). Without SMTP_HOST incidents are still recorded; deliveries are logged as "skipped".
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# ALERT_FROM="WebAudit AI <alerts@example.com>"
# Development: `npm run dev` also starts a local test inbox. Point SMTP_HOST=127.0.0.1, SMTP_PORT=2525,
# SMTP_SECURE=false at it and set SMTP_DEV_INBOX_URL=http://127.0.0.1:8025 so the app labels mail as test-only.
# SMTP_DEV_INBOX_URL=

# ---------------------------------------------------------------- real-user data (Chrome UX Report)
# "Discover what your real users are experiencing" in the Performance report. A free Google Cloud API key
# with the "Chrome UX Report API" enabled (restrict the key to that API). Server-side only. Without it the
# report says field data is not connected; nothing is estimated. Fetched once per scan and stored.
# CRUX_API_KEY=

# ---------------------------------------------------------------- billing (Stripe)
# Without these the billing page shows plans and usage only, and operators assign plans (npm run plan:set).
# Plans are granted ONLY from verified Stripe webhooks, never from the browser's return URL.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...       # from the webhook endpoint https://<your-domain>/api/billing/webhook
# STRIPE_PRICE_PRO=price_...            # recurring Price IDs
# STRIPE_PRICE_AGENCY=price_...
